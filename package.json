{
  "name": "bili-extractor",
  "version": "2.0.0",
  "private": true,
  "description": "提炼 · B站视频 / 音频 / 封面提取工具",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "check": "node scripts/ci-check.js",
    "pack": "node scripts/pack.js",
    "app:pack": "electron-builder --win portable",
    "app:zip": "node scripts/make-zip.js",
    "deps:check": "node scripts/ensure-deps.js --check"
  },
  "keywords": [
    "bilibili",
    "video",
    "audio",
    "downloader",
    "cover"
  ],
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ailciat.bili-extractor",
    "productName": "哔哩提取器",
    "asar": false,
    "artifactName": "哔哩提取器-${version}-win-x64.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "electron/**/*",
      "public/**/*",
      "scripts/**/*",
      "build/icon.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
